<?xml version="1.0" encoding="utf-8"?>
<loadFolders>
  <!--
    LoadFolders.xml - Tells RimWorld which folders to load based on game version.

    This mod supports RimWorld 1.6 and 1.7 (Biotech DLC), both from the one 1.6/ tree.
    Version-specific content (Assemblies, Defs, Patches) lives in the 1.6/ folder.
    The root "/" loads About/ and other shared metadata, rather than everything,
    since RimWorld only looks for well-known folders within these directories
  -->
  <v1.6>
    <li>/</li>
    <li>1.6</li>
    <!-- Optional-mod compat roots live under 1.6/Mods/<Mod Name>/, one gated entry
         each (the layout the wider ecosystem uses). Needed whenever content can't
         gate itself: defs support MayRequire, but DefInjected entries do not (the
         loader ignores attributes on them). Safe to nest inside 1.6 because the
         game only scans well-known folders (Languages/, Defs/, ...) directly under
         a load root, so the plain 1.6 entry above never sees Mods/. Odyssey is the one
         gate today: the lair's landmark tile mutator (a labelled def) and the patch that
         offers it on Odyssey's landmarks. Biotech is a hard dependency and needs none. -->
    <li IfModActive="ludeon.rimworld.odyssey">1.6/Mods/Odyssey</li>
  </v1.6>
  <v1.7>
    <!-- 1.7 runs the 1.6 tree unchanged: the Waylith CLR maps every UnityEngine
         reference onto UnityStubs, so the net472 assembly loads as-is. Listed
         explicitly rather than left to the game's highest-lower-version fallback.
         The compat root mirrors <v1.6> exactly; its rationale is there. -->
    <li>/</li>
    <li>1.6</li>
    <li IfModActive="ludeon.rimworld.odyssey">1.6/Mods/Odyssey</li>
  </v1.7>
</loadFolders>
