<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <!--
    SL_LairRoom_Larder: the hemogen store, with a little food and medicine for the thralls and
    prisoners. Furnished by LairRoomWorker_Larder (layout in its header): red-painted shelves
    around three walls.

    A small hewn room on flagstone, a dead end (maxChildren 0). The worker's shelf runs are
    written for a half-width and half-depth of 2 or 3, which is this size range. Hemogen packs
    do not rot, so the room needs no cooler; if the lair's power net later makes one cheap, a
    cooled larder would be a pure flourish.
  -->

  <SanguophageLair.LairRoomDef>
    <defName>SL_LairRoom_Larder</defName>
    <workerClass>SanguophageLair.LairRoomWorker_Larder</workerClass>
    <walls>Hewn</walls>
    <floor>Flagstone</floor>
    <maxChildren>0</maxChildren>
    <shapes>
      <li>
        <kind>Rect</kind>
        <across>5~7</across>
        <deep>5~7</deep>
      </li>
    </shapes>
  </SanguophageLair.LairRoomDef>

</Defs>
