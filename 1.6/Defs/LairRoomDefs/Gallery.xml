<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <!--
    SL_LairRoom_Gallery: a hall of sculpture, the vanity of immortals. Worker:
    Source/1.6/MapGen/Rooms/LairRoomWorker_Gallery.cs. Its sculptures run from good to
    masterwork quality, so the art is the room's loot.

    - Rect, seven across and eleven to fifteen deep: a three-cell carpet runner with a bay of
      sculpture on each side, long enough for the sequence of small, large and grand pairs and
      too narrow to need roof columns.
    - corridorChance 0.2: mostly wall to wall with its host, so the hall reads as a room of the
      complex rather than a place apart.
  -->

  <SanguophageLair.LairRoomDef>
    <defName>SL_LairRoom_Gallery</defName>
    <workerClass>SanguophageLair.LairRoomWorker_Gallery</workerClass>
    <corridorChance>0.2</corridorChance>
    <shapes>
      <li>
        <kind>Rect</kind>
        <across>7~7</across>
        <deep>11~15</deep>
      </li>
    </shapes>
  </SanguophageLair.LairRoomDef>

</Defs>
