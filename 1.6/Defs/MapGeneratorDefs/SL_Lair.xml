<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <!--
    SL_Lair: the pocket-map generator behind SL_AncientStairwell's portal.

    An all-rock underground map (Odyssey InsectLair's Core-only skeleton: every vanilla def
    referenced here is Core-owned) with the lair cut into it by our own steps, which are
    documented together in 1.6/Defs/GenStepDefs/LairSteps.xml. Steps run by their `order`, not
    by their position in this list; the list is written in run order for the reader.

    The UndergroundCave mutator gives the rock around the lair its natural tunnels and pools.
    The lair's walls seal it off from them, so they are somewhere to mine into, not a way in.

    label is player-facing: MapPortal composes it into "View sanguophage lair" and
    "Exit sanguophage lair" gizmo/command strings.
  -->
  <MapGeneratorDef>
    <defName>SL_Lair</defName>
    <label>sanguophage lair</label>
    <isUnderground>true</isUnderground>
    <ignoreAreaRevealedLetter>true</ignoreAreaRevealedLetter>
    <disableCallAid>true</disableCallAid>
    <pocketMapProperties>
      <biome>Underground</biome>
      <temperature>15</temperature>
      <tileMutators>
        <li>UndergroundCave</li>
      </tileMutators>
    </pocketMapProperties>
    <genSteps>
      <li>ElevationFertility</li>
      <li>MutatorPostElevationFertility</li>
      <li>SL_LairRock</li>
      <li>Underground_RocksFromGrid</li>
      <li>Terrain</li>
      <li>MutatorPostTerrain</li>
      <li>Plants</li>
      <li>RockChunks</li>
      <li>SL_LairStructure</li>
      <li>SL_PlaceStairwellExit</li>
      <li>SL_LairContents</li>
      <li>SL_LairUtilities</li>
      <li>Fog</li>
      <li>MutatorFinal</li>
    </genSteps>
  </MapGeneratorDef>

</Defs>
